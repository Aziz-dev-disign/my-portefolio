# EmailJS — used by the Contact form (src/screens/contact/Contact.tsx).
# Create an account at https://www.emailjs.com/, then copy these values.
# Copy this file to `.env` (gitignored) and fill in the real values.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: override the CV URLs used by the in-app PDF preview (/cv route)
# and the "Download my CV" button. Defaults serve from public/.
VITE_CV_PATH_FR=
VITE_CV_PATH_EN=
